---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PARENO 并言 · 在正文里写，在侧栏里判断',
  description = 'PARENO 是面向中文和英文写作者的 Obsidian 双语写作助手：正文批注、全文审校、翻译、中英核对与作者风格。'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://pareno.pages.dev');
const ogImage = new URL('/pareno-interaction-prototype.png', Astro.site ?? 'https://pareno.pages.dev');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#223d3d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
