---
const year = new Date().getFullYear();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isDesktop = ['/desktop', '/terms', '/refund', '/support'].includes(path);
const isHome = path === '/';
---
<footer class="site-footer">
  <div class="wrap">
    <div>
      <p>© {year} ArchIntera · {isDesktop ? 'Pareno Desktop' : 'PARENO 并言'}</p>
      {isDesktop ? <p class="small muted">Pareno Desktop · Proprietary</p> : isHome ? <p class="small muted">Obsidian 插件 MIT · Pareno Desktop proprietary</p> : null}
      <p>本站不收集分析数据，不使用第三方追踪脚本。</p>
      {isDesktop && <p class="small muted">Paddle.com is the Merchant of Record for Pareno Desktop orders.</p>}
    </div>
    <nav class="footer-links" aria-label="页脚链接">
      <a href="/desktop">Desktop</a>
      {!isDesktop && <a href="/install">安装</a>}
      <a href="/privacy">隐私</a>
      <a href="/terms">条款</a>
      <a href="/refund">退款</a>
      <a href="/support">支持</a>
      {!isDesktop && <a href="/feedback">反馈</a>}
      <a href="https://github.com/Jorgut/pareno" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://github.com/Jorgut/pareno/blob/main/README.md" target="_blank" rel="noopener noreferrer">README</a>
    </nav>
  </div>
</footer>
