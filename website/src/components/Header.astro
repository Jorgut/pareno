---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: '首页' },
  { href: '/install', label: '安装' },
  { href: '/privacy', label: '隐私' },
  { href: '/changelog', label: '更新日志' },
  { href: '/feedback', label: '反馈' }
];
const isCurrent = (href: string) => href === '/' ? path === '/' : path === href;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="PARENO 首页">
      <span class="brand-mark" aria-hidden="true">并</span>
      <span>
        <strong>PARENO</strong>
        <small>并言 · ARCHINTERA</small>
      </span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {links.map(link => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
      <a class="nav-cta" href="https://github.com/Jorgut/pareno" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </nav>
  </div>
</header>
